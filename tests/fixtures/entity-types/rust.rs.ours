const LIMIT: i32 = 10;
static LABEL: &str = "point";
type Number = i32;

struct Point {
    x: Number,
}

enum Color {
    Red,
    Blue,
}

trait Render {
    fn render(&self) -> String;
}

impl Render for Point {
    fn render(&self) -> String {
        format!("{}:{}", self.x, LABEL)
    }
}

macro_rules! announce {
    ($value:expr) => {
        println!("{}", $value);
    };
}

fn calculate(value: Number) -> Number {
    value + LIMIT + 1
}
